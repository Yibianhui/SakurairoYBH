+  font-family: 'Klee One', 'Sarasa UI SC', 'PingFang SC', 'Microsoft YaHei', sans-serif;
+}
+
+/* ---------- 标题与签名：多背景色可读性 ---------- */
+/* 首屏大标题：深色柔光保护层（亮背景压暗、暗背景提对比），不改变主题配色 */
+.center-text {
+  text-shadow: 0 2px 6px rgba(0, 0, 0, 0.55), 0 0 30px rgba(0, 0, 0, 0.28);
+}
+.center-text.glitch::before,
+.center-text.glitch::after {
+  text-shadow: none;
+}
+/* 导航栏站名 */
+.site-title {
+  text-shadow: 0 1px 3px rgba(0, 0, 0, 0.4);
+}
+/* 首屏头像描边 */
+.focusinfo .header-tou img {
+  box-shadow: 0 4px 18px rgba(0, 0, 0, 0.35);
+}
+/* 签名栏：无论封面明暗都保底可读（透明度下限 + 双模式底色） */
+.header-info {
+  background: rgba(255, 255, 255, max(var(--homepage_widget_transparency, 1), 0.45));
+  border-color: rgba(255, 255, 255, max(var(--homepage_widget_transparency, 1), 0.45));
+}
+.header-info p {
+  color: var(--theme-skin, #505050);
+  text-shadow: 0 1px 0 rgba(255, 255, 255, 0.25);
+}
+body.dark .header-info {
+  background: rgba(28, 28, 30, max(var(--homepage_widget_transparency, 1), 0.5));
+  border-color: rgba(255, 255, 255, 0.08);
+}
+body.dark .header-info p {
+  color: #ebebeb;
+  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
+}
+
+/* ---------- 展台：单行展示数量 3 → 4（响应式逐级回落） ---------- */
+.bento-medium {
+  grid-column: span 3;
+}
+@media (max-width: 1280px) {
+  .bento-medium {
+    grid-column: span 4;
+  }
+}
+@media (max-width: 1080px) {
+  .bento-medium {
+    grid-column: span 6;
+  }
+}
+@media (max-width: 768px) {
+  .bento-medium {
+    grid-column: span 12;
+  }
+}
