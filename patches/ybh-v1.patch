+:lang(zh):not(.fa-solid):not(.fa-regular):not(.fa-brands):not(.fas):not(.far):not(.fab):not(.fa-classic),:lang(zh-CN):not(.fa-solid):not(.fa-regular):not(.fa-brands):not(.fas):not(.far):not(.fab):not(.fa-classic),:lang(zh-Hans):not(.fa-solid):not(.fa-regular):not(.fa-brands):not(.fas):not(.far):not(.fab):not(.fa-classic) {
+  font-family: 'Sarasa UI SC', 'PingFang SC', 'Microsoft YaHei', 'TH-Tshyn', sans-serif;
+}
+:lang(zh-TW):not(.fa-solid):not(.fa-regular):not(.fa-brands):not(.fas):not(.far):not(.fab):not(.fa-classic),:lang(zh-Hant):not(.fa-solid):not(.fa-regular):not(.fa-brands):not(.fas):not(.far):not(.fab):not(.fa-classic) {
+  font-family: 'Sarasa UI TC', 'PingFang SC', 'Microsoft YaHei', 'TH-Tshyn', sans-serif;
+}
+:lang(zh-HK):not(.fa-solid):not(.fa-regular):not(.fa-brands):not(.fas):not(.far):not(.fab):not(.fa-classic),:lang(zh-MO):not(.fa-solid):not(.fa-regular):not(.fa-brands):not(.fas):not(.far):not(.fab):not(.fa-classic) {
+  font-family: 'Sarasa UI HC', 'PingFang SC', 'Microsoft YaHei', 'TH-Tshyn', sans-serif;
+}
+:lang(ja):not(.fa-solid):not(.fa-regular):not(.fa-brands):not(.fas):not(.far):not(.fab):not(.fa-classic) {
+  font-family: 'Sarasa UI J', 'PingFang SC', 'Microsoft YaHei', 'TH-Tshyn', sans-serif;
+}
+:lang(ko):not(.fa-solid):not(.fa-regular):not(.fa-brands):not(.fas):not(.far):not(.fab):not(.fa-classic) {
+  font-family: 'Sarasa UI K', 'PingFang SC', 'Microsoft YaHei', 'TH-Tshyn', sans-serif;
+}
+
+/* ---------- 中文斜体 = 霞鹜文楷（楷体作为斜体“声音”；代码块内不劫持） ---------- */
+i, em, cite, var, dfn {
+  font-family: 'LXGW WenKai', 'Sarasa UI SC', 'PingFang SC', 'Microsoft YaHei', 'TH-Tshyn', sans-serif;
+}
+code i, code em, pre i, pre em, kbd i, kbd em, samp i, samp em {
+  font-family: inherit;
+}
+
+/* ---------- 默认样式烘焙（与站点「额外 CSS」一致，作为主题默认值；额外 CSS 仍可随时覆盖） ---------- */
+.entry-content p {
+  margin: 0;
+  text-indent: 2em;
+  line-height: 2;
+}
+:root {
+  text-autospace: normal;
+  text-spacing-trim: trim-start;
+}
+
+/* 签名栏字体：弃用需走 Google 的 Noto Serif SC，改本地 Klee One */
+.header-info p {
+  font-family: 'Klee One', 'Sarasa UI SC', 'PingFang SC', 'Microsoft YaHei', sans-serif;
+}
+
+/* ---------- 标题与签名：多背景色可读性 ---------- */
+/* 首屏大标题：深色柔光保护层（亮背景压暗、暗背景提对比），不改变主题配色 */
+.center-text {
+  text-shadow: 0 2px 6px rgba(0, 0, 0, 0.55), 0 0 30px rgba(0, 0, 0, 0.28);
+}
+.center-text.glitch::before,
+.center-text.glitch::after {
+  text-shadow: none;
+}
+/* 导航栏站名 */
+.site-title {
+  text-shadow: 0 1px 3px rgba(0, 0, 0, 0.4);
+}
+/* 首屏头像描边 */
+.focusinfo .header-tou img {
+  box-shadow: 0 4px 18px rgba(0, 0, 0, 0.35);
+}
+/* 签名栏：无论封面明暗都保底可读（透明度下限 + 双模式底色） */
+.header-info {
+  background: rgba(255, 255, 255, max(var(--homepage_widget_transparency, 1), 0.45));
+  border-color: rgba(255, 255, 255, max(var(--homepage_widget_transparency, 1), 0.45));
+}
+.header-info p {
+  color: var(--theme-skin, #505050);
+  text-shadow: 0 1px 0 rgba(255, 255, 255, 0.25);
+}
+body.dark .header-info {
+  background: rgba(28, 28, 30, max(var(--homepage_widget_transparency, 1), 0.5));
+  border-color: rgba(255, 255, 255, 0.08);
+}
+body.dark .header-info p {
+  color: #ebebeb;
+  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
+}
+
+/* ---------- 展台：单行展示数量 3 → 4（响应式逐级回落；body 前缀抬高优先级，与加载顺序解耦） ---------- */
+body .bento-medium {
+  grid-column: span 3;
+}
+@media (max-width: 1280px) {
+  body .bento-medium {
+    grid-column: span 4;
+  }
+}
+@media (max-width: 1080px) {
+  body .bento-medium {
+    grid-column: span 6;
+  }
+}
+@media (max-width: 768px) {
+  body .bento-medium {
+    grid-column: span 12;
+  }
+}
+
+/* ============================================================
+   YBH 1.1 · 选项化调整（「YBH 魔改」设置区，body class 驱动）
+   ============================================================ */
+
+/* ---------- 导航：随机文章按钮（骰子右侧） ---------- */
+#ybh-random-post {
+  flex: 0 0 auto;
+  display: inline-flex;
+  align-items: center;
+  height: 100%;
+  color: inherit;
+  text-decoration: none;
+}
+#ybh-random-post i {
+  font-size: 15px;
+}
+
+/* ---------- 展台紧凑模式：单行 6 张、纵向缩短、浮层收紧 ---------- */
+body.ybh-exhibit-compact .bento-medium {
+  grid-row: span 1;
+  min-height: 8.75rem;
+}
+body.ybh-exhibit-compact.ybh-exhibit-cols-6 .bento-medium {
+  grid-column: span 2;
+}
+body.ybh-exhibit-compact.ybh-exhibit-cols-4 .bento-medium {
+  grid-column: span 3;
+}
+body.ybh-exhibit-compact.ybh-exhibit-cols-3 .bento-medium {
+  grid-column: span 4;
+}
+/* 文字避让：标题/描述浮层收紧 + 去位移去遮罩，杜绝裁字与淡化 */
+body.ybh-exhibit-compact .card-title-wrapper {
+  padding: 0.5rem 0.9rem;
+  background: linear-gradient(to bottom, rgba(0, 0, 0, 0.55) 0%, rgba(0, 0, 0, 0.35) 70%, transparent 100%);
+  mask-image: none;
+  -webkit-mask-image: none;
+  backdrop-filter: none;
+  -webkit-backdrop-filter: none;
+}
+body.ybh-exhibit-compact .bento-card-title {
+  font-size: 0.85rem;
+}
+body.ybh-exhibit-compact .card-info {
+  padding: 1.6rem 0.9rem 0.5rem;
+  transform: none;
+  opacity: 1;
+  transition: none;
+}
+body.ybh-exhibit-compact .card-description {
+  font-size: 0.78rem;
+  line-height: 1.45;
+  opacity: 1;
+}
+/* 响应式逐级回落 */
+@media (max-width: 1280px) {
+  body.ybh-exhibit-compact.ybh-exhibit-cols-6 .bento-medium,
+  body.ybh-exhibit-compact.ybh-exhibit-cols-4 .bento-medium {
+    grid-column: span 3;
+  }
+  body.ybh-exhibit-compact.ybh-exhibit-cols-3 .bento-medium {
+    grid-column: span 4;
+  }
+}
+@media (max-width: 1080px) {
+  body.ybh-exhibit-compact.ybh-exhibit-cols-6 .bento-medium,
+  body.ybh-exhibit-compact.ybh-exhibit-cols-4 .bento-medium {
+    grid-column: span 4;
+  }
+  body.ybh-exhibit-compact.ybh-exhibit-cols-3 .bento-medium {
+    grid-column: span 6;
+  }
+}
+@media (max-width: 768px) {
+  body.ybh-exhibit-compact .bento-medium {
+    grid-column: span 6;
+  }
+}
+@media (max-width: 560px) {
+  body.ybh-exhibit-compact .bento-medium {
+    grid-column: span 12;
+  }
+}
+
+/* ---------- 文章列表：两列 + 禁用摘要 ---------- */
+/* :has 限定：仅当 main 里确实有文章卡时才启用网格，避免影响文章页/独立页面的排版 */
+body.ybh-postlist-2col #primary .site-main:has(> .post-list-thumb) {
+  display: grid;
+  grid-template-columns: repeat(2, minmax(0, 1fr));
+  gap: 0 15px;
+  align-items: start;
+}
+body.ybh-postlist-2col #primary .site-main > *:not(.post-list-thumb) {
+  grid-column: 1 / -1;
+}
+body.ybh-postlist-2col .post-list-thumb {
+  float: none;
+  width: auto;
+}
+body.ybh-postlist-noexcerpt .post-list-thumb .post-excerpt {
+  display: none;
+}
+body.ybh-postlist-noexcerpt .post-list-thumb .post-title {
+  bottom: 10%;
+}
+@media (max-width: 860px) {
+  body.ybh-postlist-2col #primary .site-main:has(> .post-list-thumb) {
+    grid-template-columns: 1fr;
+  }
+}
+
+/* ---------- YBH 1.1.5：FontAwesome 图标字体锚定 ----------
+   根因：:lang(zh-Hans) 特异性(0,1,0)与 .fa-solid(0,1,0) 相同且加载在后，
+   图标(语言继承 zh-Hans)的字体栈被 :lang 规则夺走，PUA 码位落到
+   TH-Tshyn P0(U+F000-F414) → 图标显示成天珩字库的"生僻字"字形。
+   上面 :lang 规则已加 :not() 排除；此处再用 !important 双保险锚定。 */
+i.fa-solid, i.fa-classic, i.fas,
+svg.fa-solid, svg.fa-classic {
+  font-family: 'Font Awesome 6 Free' !important;
+  font-weight: 900;
+}
+i.fa-regular, i.far {
+  font-family: 'Font Awesome 6 Free' !important;
+  font-weight: 400;
+}
+i.fa-brands, i.fab, svg.fa-brands {
+  font-family: 'Font Awesome 6 Brands' !important;
+  font-weight: 400;
+}
