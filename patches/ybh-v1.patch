++    $sarasa = "'Sarasa UI SC','PingFang SC','Microsoft YaHei','TH-Tshyn',sans-serif";
++    $legacy = array('', 'Noto Serif SC', 'Noto Sans SC', 'Sarasa UI SC');
++    $keys = array(
++        'global_default_font',
